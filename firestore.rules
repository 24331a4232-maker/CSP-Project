rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'admin'])
      );
    }

    // Admins Collection: System administrators
    match /admins/{adminId} {
      allow read, create, update, delete: if true;
    }

    // Volunteers Collection: Volunteer responders and vehicle records
    match /volunteers/{volunteerId} {
      allow read, create, update, delete: if true;
    }

    // Donors Collection: Food donors and restaurants
    match /donors/{donorId} {
      allow read, create, update, delete: if true;
    }

    // Users and Profiles Collections: Synchronized user records
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    match /profiles/{profileId} {
      allow read, create, update, delete: if true;
    }

    // Food Donations & Live Donations Collections: Listed food items, surplus batches and allocations
    match /donations/{donationId} {
      allow read, create, update, delete: if true;
    }

    match /food_donations/{donationId} {
      allow read, create, update, delete: if true;
    }

    // Locations Collection: Live GPS and pickup routing coordinates
    match /locations/{locationId} {
      allow read, create, update, delete: if true;
    }

    // Pickups Table: Logistics handovers and volunteer dispatches
    match /pickups/{pickupId} {
      allow read, create, update, delete: if true;
    }

    // Notifications Table: System alerts, dispatch notices and status updates
    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }

    // Login Activity Table: Audit logs and security events
    match /login_activity/{activityId} {
      allow read, create, update, delete: if true;
    }

    // Contact Messages Table: Inquiries and support messages
    match /contact_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Certificates Table: Volunteer and donor recognition certificates
    match /certificates/{certificateId} {
      allow read, create, update, delete: if true;
    }

    // Default fallback rule: allow read and write across all collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

